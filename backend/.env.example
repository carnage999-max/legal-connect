# Copy to .env on the server and fill in. Never commit .env.

# --- Django ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.legalconnectapp.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://legalconnectapp.com,https://www.legalconnectapp.com
CSRF_TRUSTED_ORIGINS=https://api.legalconnectapp.com
SITE_DOMAIN=legalconnectapp.com
SITE_NAME=Legal Connect
SITE_URL=https://legalconnectapp.com
FRONTEND_URL=https://legalconnectapp.com

# --- Database (Postgres on the shared-net Docker network) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=legal_connect
DB_USER=legal_connect
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# --- Redis (channel layer; used when DEBUG=False) ---
REDIS_URL=redis://redis:6379/3

# --- Email (Resend) ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=info@legalconnectapp.com

# --- Payments ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Uploaded files (a host folder mounted into the container) ---
MEDIA_ROOT=/app/media

# --- gunicorn (optional) ---
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
