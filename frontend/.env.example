# Copy to .env on the server. docker compose reads NEXT_PUBLIC_API_BASE_URL
# from this file at build time; the rest are read by the running container.

NEXT_PUBLIC_API_BASE_URL=https://api.legalconnectapp.com

# Account-deletion request emails (/delete-account)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=support@legalconnectapp.com
